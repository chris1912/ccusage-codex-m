if [[ -n "${USERPROFILE:-}" ]] && command -v cygpath >/dev/null 2>&1; then
  codex_home="$(cygpath -m "$USERPROFILE/.codex")"
else
  codex_home="$HOME/.codex"
fi

export CODEX_HOME="$codex_home"

if [[ -z "${CCUSAGE_CODEX_REPO:-}" || ! -f "$CCUSAGE_CODEX_REPO/ccusage_m_view.js" ]]; then
  echo "Set CCUSAGE_CODEX_REPO to the local ccusage-codex-m repository before loading this snippet." >&2
  return 1
fi

ccusage-codex-m() {
  node "$CCUSAGE_CODEX_REPO/ccusage_m_view.js" daily "$@"
}

ccusage-codex-monthly() {
  node "$CCUSAGE_CODEX_REPO/ccusage_m_view.js" monthly "$@"
}

ccusage-codex-open() {
  node "$CCUSAGE_CODEX_REPO/ccusage_m_view.js" sessions "$@"
}
